# ─── Halo Onboarding Workflow ────────────────────────────────────────────────
# Copy to .env and fill in. With MOCK_INTEGRATIONS=true the app runs end-to-end
# with no external credentials — perfect for local dev, demos, and CI.

# ─── Runtime ─────────────────────────────────────────────────────────────────
APP_ENV=development                # development | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/onboarding.db

# ─── Feature flags ───────────────────────────────────────────────────────────
MOCK_INTEGRATIONS=true             # when true, all integrations use the in-memory fakes
QUESTIONNAIRE_DEGRADE_DAYS=3       # T+N days with no questionnaire → AM-fill-in mode
REMINDER_DAYS=3                    # T+N days with missing assets → reminder draft

# ─── E-sign webhooks ─────────────────────────────────────────────────────────
DOCUSIGN_WEBHOOK_SECRET=replace-me
PANDADOC_WEBHOOK_SECRET=replace-me

# ─── Integrations (only required when MOCK_INTEGRATIONS=false) ───────────────
TYPEFORM_API_TOKEN=
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=
SLACK_BOT_TOKEN=
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ─── Claude (brief drafter) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ─── Halo identity (used in draft signatures, slack naming) ──────────────────
AGENCY_NAME=Halo Brand Studio
AGENCY_DOMAIN=halo.studio
SLACK_CHANNEL_PREFIX=client
